---
import ProjectView from '@/components/sections/ProjectView.astro';
import { projects } from '@/data/projects';
import type { Project } from '@/data/types';
import ShellLayout from '@/layouts/ShellLayout.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<ShellLayout
  navId="projects"
  title={project.name}
  paneTitle="Projects"
  description={project.summary}
  command={`cat projects/${project.slug}/README.md`}
  fileLabel={`projects/${project.slug}/README.md`}
  projectPager
>
  <ProjectView project={project} projects={projects} />
</ShellLayout>
