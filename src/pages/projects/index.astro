---
// /projects/ shows the first project, same view as /projects/<slug>/.
import ProjectView from '@/components/sections/ProjectView.astro';
import { projects } from '@/data/projects';
import ShellLayout from '@/layouts/ShellLayout.astro';

const first = projects[0];
if (!first) throw new Error('src/data/projects.ts needs at least one project');
---

<ShellLayout
  navId="projects"
  command={`cat projects/${first.slug}/README.md`}
  fileLabel={`projects/${first.slug}/README.md`}
  projectPager
>
  <ProjectView project={first} projects={projects} />
</ShellLayout>
