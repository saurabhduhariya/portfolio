---
// One project per screen: framed screenshot on the left, details on the right, pager below.
// On wide panes the view fills exactly the remaining pane height, so nothing scrolls: the
// screenshot frame shrinks to fit. On narrow panes (phones) it stacks.
// Screenshots are picked up automatically from src/assets/images/projects/<slug>.(png|jpg|jpeg|webp|avif).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ExternalLink from '@lucide/astro/icons/external-link';
import type { Project } from '@/data/types';

interface Props {
  project: Project;
  projects: readonly Project[];
}

const { project, projects } = Astro.props;

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const screenshot = Object.entries(screenshots).find(
  ([path]) =>
    path
      .split('/')
      .pop()
      ?.replace(/\.[^.]+$/, '') === project.slug,
)?.[1].default;

const index = projects.findIndex((p) => p.slug === project.slug);
const previous = projects[index - 1];
const next = projects[index + 1];
const href = (p: Project) => `/projects/${p.slug}/`;
const [primaryLink, ...otherLinks] = project.links;
const number = String(index + 1).padStart(2, '0');
---

<article class="project">
  <div class="layout">
    <div class="body">
      <figure class="frame">
        <div class="titlebar" aria-hidden="true">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="path">~/projects/{project.slug}</span>
        </div>
        {screenshot ? (
          <Image
            class="shot"
            src={screenshot}
            alt={`Screenshot of ${project.name}`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1200px) 560px, (min-width: 900px) 45vw, 100vw"
            loading="eager"
          />
        ) : (
          <div class="shot placeholder" aria-hidden="true">
            <span class="placeholder-number">{number}</span>
            <span class="placeholder-name">{project.name}</span>
          </div>
        )}
      </figure>

      <div class="info">
        <h2 class="name">{project.name}</h2>
        <p class="summary">{project.summary}</p>
        {project.metric && <p class="metric">▲ {project.metric}</p>}

        <ul class="points" role="list">
          {project.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>

        <div class="links">
          {primaryLink && (
            <a class="button primary" href={primaryLink.url} target="_blank" rel="noreferrer">
              {primaryLink.label}
              <ExternalLink size="0.9em" aria-hidden="true" />
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          )}
          {otherLinks.map((link) => (
            <a class="button" href={link.url} target="_blank" rel="noreferrer">
              {link.label}
              <ExternalLink size="0.9em" aria-hidden="true" />
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <nav class="pager" aria-label="Projects">
      {previous ? (
        <a
          class="step"
          href={href(previous)}
          rel="prev"
          aria-label={`Previous project: ${previous.name}`}
        >
          <span aria-hidden="true">←</span>
          <span class="step-name">{previous.name}</span>
        </a>
      ) : (
        <span class="step disabled" aria-hidden="true">
          ←
        </span>
      )}
      <ul class="dots" role="list">
        {projects.map((p, i) => (
          <li>
            <a
              class:list={['dot-link', { current: i === index }]}
              href={href(p)}
              aria-label={p.name}
              aria-current={i === index ? 'page' : undefined}
            />
          </li>
        ))}
      </ul>
      {next ? (
        <a class="step next" href={href(next)} rel="next" aria-label={`Next project: ${next.name}`}>
          <span class="step-name">{next.name}</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="step next disabled" aria-hidden="true">
          →
        </span>
      )}
    </nav>
  </div>
</article>

<style>
  /* Fills the rest of the content pane (which is a flex column). */
  .project {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-block-size: 0;
    container-type: inline-size;
  }

  /* ---------- narrow (default): stacked, pane may scroll on phones ---------- */
  .layout {
    display: grid;
    gap: var(--space-4);
  }

  .body {
    display: grid;
    gap: var(--space-4);
  }

  /* Phones: a wider, shorter frame and no bullet points, so one project fits the screen. */
  .shot {
    aspect-ratio: 2 / 1;
  }

  .points {
    display: none;
  }

  /* ---------- wide: side by side, exactly one screen tall ---------- */
  @container (min-width: 36rem) {
    .shot {
      aspect-ratio: 16 / 10;
    }

    .points {
      display: grid;
    }

    .layout {
      flex: 1 1 auto;
      grid-template-rows: minmax(0, 1fr) auto;
      min-block-size: 0;
    }

    .body {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: center;
      min-block-size: 0;
    }

    /* Keeps its 16:10 shape but never grows taller than the space left. */
    .frame {
      display: flex;
      flex-direction: column;
      max-block-size: 100%;
    }

    .shot {
      flex: 1 1 auto;
      min-block-size: 0;
    }

    .info {
      max-block-size: 100%;
      overflow-y: auto;
    }
  }

  /* ---------- screenshot frame ---------- */
  .frame {
    margin: 0;
    overflow: hidden;
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 0 0 var(--space-1) color-mix(in srgb, var(--color-bg) 60%, transparent);
  }

  .titlebar {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface-raised);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .dot {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
  }

  .red {
    background-color: var(--color-danger);
  }

  .yellow {
    background-color: var(--color-accent);
  }

  .green {
    background-color: var(--color-success);
  }

  .path {
    margin-inline-start: var(--space-2);
    overflow: hidden;
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text-muted-raised);
  }

  .shot {
    display: block;
    inline-size: 100%;
    block-size: auto;
    object-fit: cover;
    object-position: top;
  }

  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-1);
    background-color: var(--color-bg);
    background-image: radial-gradient(var(--color-border) 1px, transparent 1px);
    background-size: 1rem 1rem;
  }

  .placeholder-number {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .placeholder-name {
    font-size: clamp(var(--text-xl), 4cqi, 2.5rem);
    font-weight: var(--weight-heavy);
    line-height: var(--leading-tight);
    color: var(--color-text-muted);
  }

  /* ---------- details ---------- */
  .info {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .name {
    font-size: clamp(var(--text-xl), 3.5cqi, 2.25rem);
    font-weight: var(--weight-heavy);
    line-height: var(--leading-tight);
  }

  .summary {
    color: var(--color-text-muted);
  }

  .metric {
    inline-size: fit-content;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-success);
    background-color: color-mix(in srgb, var(--color-success) 10%, transparent);
    border: var(--border-width) solid color-mix(in srgb, var(--color-success) 60%, transparent);
    border-radius: var(--radius);
  }

  /* display is set by the container/media queries above and below. */
  .points {
    gap: var(--space-1);
    padding-inline-start: var(--space-3);
    font-size: var(--text-sm);
    border-inline-start: calc(var(--border-width) * 2) solid var(--color-border);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block-start: var(--space-1);
  }

  .button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-1) var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .button.primary {
    font-weight: var(--weight-bold);
    color: var(--color-text-on-accent);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .button.primary:hover {
    color: var(--color-text-on-accent);
    background-color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  /* ---------- pager ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-block-start: var(--space-3);
    font-size: var(--text-sm);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .step {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    justify-self: start;
    text-decoration: none;
  }

  .step.next {
    justify-self: end;
  }

  .step.disabled {
    color: var(--color-text-faint);
  }

  .dots {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  /* The link is a 24×24px touch target (WCAG 2.5.8); the visible dot is drawn inside it. */
  .dots {
    gap: 0;
  }

  .dot-link {
    display: grid;
    place-items: center;
    min-inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .dot-link::before {
    content: '';
    inline-size: 0.6rem;
    block-size: 0.6rem;
    background-color: var(--color-border);
    border-radius: 50%;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      inline-size var(--duration-base) var(--ease-out);
  }

  .dot-link:hover::before {
    background-color: var(--color-text-muted);
  }

  .dot-link.current {
    min-inline-size: 2rem;
  }

  .dot-link.current::before {
    inline-size: 1.5rem;
    background-color: var(--color-accent);
    border-radius: var(--radius);
  }

  @container (max-width: 28rem) {
    .step-name {
      display: none;
    }
  }

  /* Short screens (small laptops): bullet points would not fit beside the screenshot. */
  @media (max-height: 42rem) {
    .points {
      display: none;
    }
  }
</style>
