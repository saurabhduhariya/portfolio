---
import SectionLabel from '@/components/ui/SectionLabel.astro';
import type { Credit } from '@/data/types';

interface Props {
  inspiration: Credit;
  credits: readonly Credit[];
  authorName: string;
  authorUrl: string;
}

const { inspiration, credits, authorName, authorUrl } = Astro.props;
---

<div class="credits">
  <section class="inspiration" aria-labelledby="inspired-heading">
    <SectionLabel id="inspired-heading">Inspired by</SectionLabel>
    <p>
      <a href={inspiration.url} target="_blank" rel="noreferrer">
        {inspiration.name}
      </a>
    </p>
    <p class="note">{inspiration.note}</p>
  </section>

  <section aria-labelledby="built-heading">
    <SectionLabel id="built-heading">Built with</SectionLabel>
    <dl class="list">
      {credits.map((credit) => (
        <div class="row">
          <dt>
            <a href={credit.url} target="_blank" rel="noreferrer">
              {credit.name}
            </a>
          </dt>
          <dd>{credit.note}</dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="signature">
    Designed and built by{' '}
    <a href={authorUrl} target="_blank" rel="noreferrer">
      {authorName}
    </a>
    .
  </p>
</div>

<style>
  .credits {
    display: grid;
    gap: var(--space-8);
  }

  .inspiration {
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-inline-start: calc(var(--border-width) * 3) solid var(--color-accent);
    border-radius: var(--radius);
  }

  .note {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }

  .row {
    display: grid;
    grid-template-columns: 16ch minmax(0, 1fr);
    gap: var(--space-ch);
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .signature {
    color: var(--color-text-muted);
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin-block-end: var(--space-2);
    }
  }
</style>
