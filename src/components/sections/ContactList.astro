---
// Contact: status line, intro, one row per contact. The email row has a "copy" button
// (scripts/copy.ts) that sits on top of the row link, so the two are never nested.
import ContactIcon from '@/components/ui/ContactIcon.astro';
import type { Contact } from '@/data/types';

interface Props {
  intro: string;
  contacts: readonly Contact[];
  status: string;
}

const { intro, contacts, status } = Astro.props;
---

<div class="contact">
  <div class="lead">
    <p class="status">
      <span class="dot" aria-hidden="true"></span>
      {status}
    </p>
    <p>{intro}</p>
  </div>
  <ul class="list" role="list">
    {contacts.map((contact) => {
      const isExternal = contact.url.startsWith('https://');
      const copyValue = contact.url.startsWith('mailto:') ? contact.handle : undefined;
      return (
        <li class="item">
          <a
            class:list={['row', { 'has-copy': copyValue }]}
            href={contact.url}
            {...(isExternal ? { target: '_blank', rel: 'noreferrer' } : {})}
          >
            <span class="icon">
              <ContactIcon icon={contact.icon} />
            </span>
            <span class="label">{contact.label}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
            <span class="handle">{contact.handle}</span>
            {isExternal && <span class="visually-hidden">(opens in a new tab)</span>}
          </a>
          {copyValue && (
            <>
              <button
                class="copy"
                type="button"
                data-copy={copyValue}
                aria-label={`Copy ${contact.label.toLowerCase()} address`}
              >
                <span data-copy-label>copy</span>
              </button>
              <span class="visually-hidden" role="status" data-copy-status />
            </>
          )}
        </li>
      );
    })}
  </ul>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
  }

  .lead {
    display: grid;
    gap: var(--space-3);
  }

  .status {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: var(--weight-bold);
    color: var(--color-success);
  }

  .dot {
    flex-shrink: 0;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    background-color: currentColor;
    border-radius: 50%;
    box-shadow: 0 0 0 0.25rem color-mix(in srgb, currentColor 20%, transparent);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }

  .item {
    position: relative;
  }

  .row {
    display: grid;
    grid-template-columns: 1.5em 9ch 2ch minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  /* Room for the copy button on the right. */
  .row.has-copy {
    padding-inline-end: calc(var(--space-4) + 6.5rem);
  }

  .row:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .icon {
    display: grid;
    place-items: center;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .row:hover .icon,
  .row:hover .handle {
    color: var(--color-accent);
  }

  .label {
    font-weight: var(--weight-bold);
    color: var(--color-info);
  }

  .arrow {
    color: var(--color-text-faint);
  }

  .handle {
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* ---------- copy button ---------- */
  .copy {
    position: absolute;
    inset-block: var(--space-2);
    inset-inline-end: var(--space-2);
    min-inline-size: 6rem;
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    cursor: pointer;
    background-color: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .copy:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .copy[data-copied] {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1.5em minmax(0, 1fr);
      gap: 0 var(--space-2);
    }

    .arrow {
      display: none;
    }

    .handle {
      grid-column: 2;
      font-size: var(--text-sm);
    }

    /* Phones: the address gets the full row width; "copy" sits under the row. */
    .row.has-copy {
      padding-inline-end: var(--space-4);
    }

    .copy {
      position: static;
      min-block-size: 2rem;
      margin-block-start: var(--space-2);
    }
  }
</style>
