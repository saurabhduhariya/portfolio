---
// Hobbies as compact rows of equal height: name, a frequency meter and a one-line description
// (truncated with "…"; the full text is in the tooltip).
import OutLink from '@/components/ui/OutLink.astro';
import type { Hobby } from '@/data/types';

interface Props {
  hobbies: readonly Hobby[];
}

const { hobbies } = Astro.props;

const SEGMENTS = 5;
const filled: Record<Hobby['frequency'], number> = { daily: 5, often: 3, sometimes: 2 };
---

<ul class="hobbies" role="list">
  {hobbies.map((hobby) => (
    <li class:list={['hobby', `is-${hobby.frequency}`]}>
      <p class="name">
        {hobby.url ? <OutLink href={hobby.url}>{hobby.name}</OutLink> : hobby.name}
      </p>
      <p class="frequency">
        <span class="meter" aria-hidden="true">
          {Array.from({ length: SEGMENTS }, (_, i) => (
            <span class:list={['segment', { on: i < filled[hobby.frequency] }]} />
          ))}
        </span>
        <span class="label">{hobby.frequency}</span>
      </p>
      <p class="description" title={hobby.description}>
        {hobby.description}
      </p>
    </li>
  ))}
</ul>

<style>
  .hobbies {
    display: grid;
    gap: var(--space-2);
    container-type: inline-size;
  }

  .hobby {
    --level-color: var(--color-text-muted);

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .hobby:hover,
  .hobby:focus-within {
    border-color: var(--color-accent);
  }

  .is-daily {
    --level-color: var(--color-success);
  }

  .is-often {
    --level-color: var(--color-info);
  }

  .name {
    font-weight: var(--weight-bold);
    color: var(--color-text);
    white-space: nowrap;
  }

  .frequency {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .meter {
    display: inline-flex;
    gap: 2px;
  }

  .segment {
    inline-size: 0.5rem;
    block-size: 0.75rem;
    background-color: var(--color-border);
    border-radius: 1px;
  }

  .segment.on {
    background-color: var(--level-color);
  }

  /* Fixed width so every meter lines up, whatever the label. */
  .label {
    min-inline-size: 9ch;
    font-size: var(--text-sm);
    color: var(--level-color);
  }

  /* One line in every layout, so all rows have the same height. */
  .description {
    grid-column: 1 / -1;
    max-inline-size: none;
    overflow: hidden;
    font-size: var(--text-sm);
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-text-muted);
  }

  /* Short screens (≤ 736px tall): slimmer rows so all five fit without scrolling. */
  @media (max-height: 46rem) {
    .hobbies {
      gap: var(--space-1);
    }

    .hobby {
      row-gap: 0;
      padding-block: var(--space-2);
    }
  }

  /* Wide panes: name | meter | description on one line. */
  @container (min-width: 44rem) {
    .hobby {
      grid-template-columns: 16ch auto minmax(0, 1fr);
      gap: var(--space-6);
    }

    .description {
      grid-column: auto;
      font-size: var(--text-base);
    }
  }
</style>
