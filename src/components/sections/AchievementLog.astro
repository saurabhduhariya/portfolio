---
// Achievements rendered like `git log --graph`: each commit gets its own graph colour, every
// title uses the same style, and linked titles end in "↗".
import OutLink from '@/components/ui/OutLink.astro';
import type { Achievement } from '@/data/types';
import { shortHash } from '@/lib/hash';

interface Props {
  entries: readonly Achievement[];
}

const { entries } = Astro.props;

// Semantic theme tokens, cycled per commit. All pass AA on --color-surface.
const tones = ['accent', 'info', 'success', 'tag'] as const;
---

<ol class="log" role="list">
  {entries.map((entry, index) => (
    <li class="commit" style={`--tone: var(--color-${tones[index % tones.length]})`}>
      <span class="graph" aria-hidden="true">
        *
      </span>
      <div class="body">
        <p class="line">
          <span class="hash" aria-hidden="true">
            {shortHash(entry.title)}
          </span>
          {index === 0 && (
            <span class="ref" aria-hidden="true">
              (HEAD -&gt; main)
            </span>
          )}
          <span class="title">
            {entry.url ? <OutLink href={entry.url}>{entry.title}</OutLink> : entry.title}
          </span>
          {entry.date && <span class="date">{entry.date}</span>}
        </p>
        <ul class="detail" role="list">
          {entry.detail.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    </li>
  ))}
</ol>

<style>
  .log {
    display: grid;
  }

  .commit {
    display: grid;
    grid-template-columns: 2.5ch minmax(0, 1fr);
  }

  .graph {
    position: relative;
    font-weight: var(--weight-heavy);
    color: var(--tone);
  }

  /* The vertical line that joins this commit to the next one, in this commit's colour. */
  .graph::after {
    position: absolute;
    inset-block: calc(var(--leading-body) * 1em) 0;
    inset-inline-start: 0.3ch;
    content: '';
    border-inline-start: calc(var(--border-width) * 2) solid
      color-mix(in srgb, var(--tone) 55%, transparent);
  }

  .commit:last-child .graph::after {
    display: none;
  }

  .body {
    padding-block-end: var(--space-8);
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-ch);
    max-inline-size: none;
  }

  .hash {
    color: var(--tone);
  }

  .ref {
    font-weight: var(--weight-bold);
    color: var(--color-info);
  }

  .title {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .date {
    color: var(--color-text-muted);
  }

  .date::before {
    content: '· ';
  }

  .detail {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
