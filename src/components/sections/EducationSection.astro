---
// Education: school card with a CGPA meter, then coursework as an `ls`-style list.
import OutLink from '@/components/ui/OutLink.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import type { Profile } from '@/data/types';

interface Props {
  education: Profile['education'];
}

const { education } = Astro.props;

// "8.40 / 10" → 10 blocks: 8 full, the 9th 40 % full, the 10th empty.
const BLOCKS = 10;
const [value = 0, max = 10] = education.cgpa.split('/').map((part) => Number.parseFloat(part));
const ratio = max > 0 ? Math.min(Math.max(value / max, 0), 1) : 0;
const fills = Array.from({ length: BLOCKS }, (_, i) =>
  Math.round(Math.min(Math.max(ratio * BLOCKS - i, 0), 1) * 100),
);

const details = [
  { label: 'degree', value: education.degree },
  { label: 'graduation', value: education.graduation },
  { label: 'location', value: education.location },
];
---

<div class="education">
  <section class="school-card" aria-labelledby="school-heading">
    <h2 id="school-heading" class="school">
      <OutLink href={education.schoolUrl}>{education.school}</OutLink>
    </h2>
    <dl>
      <div class="row">
        <dt>cgpa</dt>
        <dd class="cgpa">
          <span class="meter" aria-hidden="true">
            {fills.map((fill) => (
              <span class="block" style={`--fill: ${fill}%`} />
            ))}
          </span>
          <span class="cgpa-value">{education.cgpa}</span>
        </dd>
      </div>
      {details.map((detail) => (
        <div class="row">
          <dt>{detail.label}</dt>
          <dd>{detail.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="coursework" aria-labelledby="coursework-heading">
    <SectionLabel id="coursework-heading">Relevant coursework</SectionLabel>
    <ul class="courses" role="list">
      {education.coursework.map((course) => (
        <li>
          <span class="marker" aria-hidden="true">
            ▸
          </span>
          <span>{course}</span>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .education {
    display: grid;
    gap: var(--space-8);
  }

  .school-card {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-inline-start: calc(var(--border-width) * 3) solid var(--color-accent);
    border-radius: var(--radius);
  }

  /* Tight leading: the long school name wraps onto two lines on narrower panes. */
  .school {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
  }

  dl {
    display: grid;
    gap: var(--space-2);
  }

  .row {
    display: grid;
    grid-template-columns: 11ch minmax(0, 1fr);
    gap: var(--space-ch);
  }

  dt {
    font-weight: var(--weight-bold);
    color: var(--color-info);
  }

  dt::after {
    content: ':';
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
  }

  /* ---------- CGPA meter ---------- */
  .cgpa {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
  }

  .meter {
    display: inline-flex;
    gap: 3px;
  }

  .block {
    inline-size: 0.6rem;
    block-size: 0.9rem;
    background: linear-gradient(
      to right,
      var(--color-success) var(--fill),
      var(--color-border) var(--fill)
    );
    border-radius: 1px;
  }

  .cgpa-value {
    font-weight: var(--weight-bold);
    color: var(--color-success);
  }

  /* ---------- coursework, `ls` style ---------- */
  .coursework {
    container-type: inline-size;
  }

  .courses {
    display: grid;
    gap: var(--space-2) var(--space-8);
  }

  .courses li {
    display: flex;
    gap: var(--space-2);
  }

  .marker {
    color: var(--color-info);
  }

  @container (min-width: 36rem) {
    .courses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Short screens, and small desktops (900-1199px wide) up to 832px tall where the school
     name, degree and course names wrap onto extra lines: tighter rhythm so the page fits. */
  @media (max-height: 46rem),
    (min-width: 56.25rem) and (max-width: 74.99rem) and (max-height: 52rem) {
    .education {
      gap: var(--space-4);
    }

    .school-card {
      gap: var(--space-2);
      padding-block: var(--space-3);
    }

    dl,
    .courses {
      row-gap: var(--space-1);
    }
  }

  /* Small desktops: the course columns are narrow, so the names drop to 14px and the longest
     ("Computer Architecture & Organization") still fits on one line at 1024px wide. */
  @media (min-width: 56.25rem) and (max-width: 74.99rem) and (max-height: 52rem) {
    .courses {
      column-gap: var(--space-6);
      font-size: var(--text-sm);
    }
  }

  @media (max-width: 30rem) {
    .school-card {
      padding: var(--space-3) var(--space-4);
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
