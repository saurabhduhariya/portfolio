---
import ExternalLink from '@lucide/astro/icons/external-link';
import TagList from '@/components/ui/TagList.astro';
import type { Project } from '@/data/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detailPath = `/projects/${project.slug}/`;
---

<article class="card">
  <header class="head">
    <h2 class="name">
      <a href={detailPath}>
        <span class="dir" aria-hidden="true">
          ./
        </span>
        {project.name}
      </a>
    </h2>
    <span class="year">{project.year}</span>
  </header>

  <p class="summary">{project.summary}</p>
  {project.metric && <p class="metric">{project.metric}</p>}

  <TagList items={project.stack} label={`${project.name} tech stack`} />

  <footer class="links">
    <a href={detailPath}>
      Read more <span aria-hidden="true">→</span>
    </a>
    {project.links.map((link) => (
      <a href={link.url} target="_blank" rel="noreferrer" class="external">
        {link.label}
        <ExternalLink size="0.9em" aria-hidden="true" />
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    ))}
  </footer>
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-accent);
  }

  .head {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
  }

  .name {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .name a:hover {
    color: var(--color-accent);
  }

  .dir {
    color: var(--color-info);
  }

  .year {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .summary {
    color: var(--color-text-muted);
  }

  .metric {
    font-weight: var(--weight-semibold);
    color: var(--color-success);
  }

  .metric::before {
    content: '▲ ';
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-block-start: var(--space-2);
    font-size: var(--text-sm);
  }

  .external {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
  }

  @media (max-width: 30rem) {
    .card {
      padding: var(--space-4);
    }
  }
</style>
