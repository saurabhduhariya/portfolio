---
import BrandIcon from '@/components/ui/BrandIcon.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import type { SkillGroup } from '@/data/types';

interface Props {
  groups: readonly SkillGroup[];
}

const { groups } = Astro.props;

function dirName(title: string): string {
  return `${title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')}/`;
}
---

<div class="skills">
  {groups.map((group) => (
    <section class="group">
      <SectionLabel>
        {group.title} <span class="dir">{dirName(group.title)}</span>
      </SectionLabel>
      <ul class="items" role="list">
        {group.items.map((item) => (
          <li class="item">
            {item.icon ? (
              <BrandIcon slug={item.icon} />
            ) : (
              <span class="bullet" aria-hidden="true">
                ›
              </span>
            )}
            <span>{item.name}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .skills {
    display: grid;
    gap: var(--space-8);
  }

  .dir {
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--color-info);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-2);
  }

  .item {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .item :global(.brand-icon) {
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .item:hover {
    border-color: var(--color-accent);
  }

  .item:hover :global(.brand-icon) {
    color: var(--color-accent);
  }

  .bullet {
    inline-size: 1em;
    text-align: center;
    color: var(--color-text-faint);
  }

  @media (max-width: 30rem) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
