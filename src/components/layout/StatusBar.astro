---
// Powerline-style status bar:
// [NORMAL]▶[file]▶  j k section · 1-7 jump  ◀[2/7]◀[14:32]
// Chevrons are drawn with clip-path; each segment overlaps the previous one by --chevron so the
// cut-out triangles show the neighbour's colour. scripts/mode.ts switches NORMAL ↔ VISUAL.
export interface KeyHint {
  keys: string[];
  label: string;
}

interface Props {
  fileLabel: string;
  position: number | undefined;
  total: number;
  hints: readonly KeyHint[];
}

const { fileLabel, position, total, hints } = Astro.props;
---

<footer class="status-bar" data-mode-state="normal">
  <span class="seg mode" data-mode aria-hidden="true">
    NORMAL
  </span>
  <span class="seg file">
    <span class="file-text">{fileLabel}</span>
  </span>
  <span class="hints" aria-hidden="true">
    {hints.map((hint) => (
      <span class="hint">
        <span class="keys">{hint.keys.join(' ')}</span>
        <span class="hint-label">{hint.label}</span>
      </span>
    ))}
  </span>
  <span class="right">
    {position !== undefined && <span class="seg position">{`${position}/${total}`}</span>}
    <!-- "--:--" reserves the width (no layout shift); it stays invisible until clock.ts runs. -->
    <span class="seg clock">
      <time data-clock>--:--</time>
    </span>
  </span>
</footer>

<style>
  .status-bar {
    display: flex;
    align-items: stretch;
    min-block-size: var(--statusbar-height);
    font-size: var(--text-sm);
    white-space: nowrap;
    color: var(--color-text-muted-raised);
    background-color: var(--color-surface-raised);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .seg {
    position: relative;
    display: flex;
    align-items: center;
    padding-inline: var(--space-4);
  }

  /* ----- left: arrows point right ----- */
  .mode,
  .file {
    clip-path: polygon(
      0 0,
      calc(100% - var(--chevron)) 0,
      100% 50%,
      calc(100% - var(--chevron)) 100%,
      0 100%
    );
  }

  .mode {
    z-index: 2;
    padding-inline-end: calc(var(--space-4) + var(--chevron));
    font-weight: var(--weight-heavy);
    color: var(--color-text-on-accent);
    background-color: var(--color-accent);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  [data-mode-state='visual'] .mode {
    background-color: var(--color-accent-strong);
  }

  .file {
    z-index: 1;
    flex-shrink: 1;
    min-inline-size: 0;
    margin-inline-start: calc(var(--chevron) * -1);
    padding-inline: calc(var(--space-4) + var(--chevron));
    color: var(--color-text);
    background-color: var(--color-border);
  }

  .file-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ----- middle: key hints (keyboard + mouse, wide screens only) ----- */
  .hints {
    display: none;
    gap: var(--space-6);
    align-items: center;
    padding-inline: var(--space-4);
  }

  .hint {
    display: inline-flex;
    gap: var(--space-2);
  }

  .keys {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  /* ----- right: arrows point left ----- */
  .right {
    display: flex;
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  .position,
  .clock {
    padding-inline: calc(var(--space-4) + var(--chevron)) var(--space-4);
    clip-path: polygon(var(--chevron) 0, 100% 0, 100% 100%, var(--chevron) 100%, 0 50%);
  }

  .position {
    color: var(--color-text);
    background-color: var(--color-border);
  }

  .clock {
    z-index: 1;
    margin-inline-start: calc(var(--chevron) * -1);
    font-weight: var(--weight-heavy);
    color: var(--color-text-on-accent);
    background-color: var(--color-accent);
  }

  /* Placeholder keeps its width but is invisible until the real time is set. */
  .clock time:not([data-ready]) {
    visibility: hidden;
  }

  @media (min-width: 56.25rem) and (hover: hover) and (pointer: fine) {
    .hints {
      display: flex;
    }
  }

  @media (max-width: 30rem) {
    .seg {
      padding-inline: var(--space-3);
    }

    .mode {
      padding-inline-end: calc(var(--space-3) + var(--chevron));
    }

    .file {
      padding-inline: calc(var(--space-3) + var(--chevron));
    }

    .position,
    .clock {
      padding-inline: calc(var(--space-3) + var(--chevron)) var(--space-3);
    }
  }
</style>
