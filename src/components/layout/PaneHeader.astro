---
interface Props {
  user: string;
  host: string;
  command: string;
  title: string;
}

const { user, host, command, title } = Astro.props;
---

<header class="pane-header">
  <p class="prompt" aria-hidden="true">
    <span class="user">
      {user}@{host}
    </span>
    <span class="sep">:</span>
    <span class="path">~</span>
    <span class="sep">$</span>
    <span class="command">{command}</span>
    <span class="cursor"></span>
  </p>
  <h1>{title}</h1>
</header>

<style>
  .pane-header {
    display: grid;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    margin-block-end: var(--space-6);
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .prompt {
    max-inline-size: none;
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .user {
    font-weight: var(--weight-bold);
    color: var(--color-success);
  }

  .sep {
    color: var(--color-text-muted);
  }

  .path {
    color: var(--color-info);
  }

  /* One character of space after "$", independent of HTML whitespace. */
  .command {
    margin-inline-start: var(--space-ch);
    color: var(--color-text);
  }

  .cursor {
    display: inline-block;
    inline-size: 0.6em;
    block-size: 1.1em;
    margin-inline-start: var(--space-1);
    vertical-align: text-bottom;
    background-color: var(--color-accent);
    animation: blink var(--cursor-blink) steps(1) infinite;
  }

  h1 {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
