---
import type { NavItem } from '@/data/types';

interface Props {
  items: readonly NavItem[];
  currentId: string | undefined;
  /** Shown above the tree, e.g. "~/saurabh". */
  rootLabel: string;
}

const { items, currentId, rootLabel } = Astro.props;
const lastIndex = items.length - 1;
---

<nav class="file-tree" aria-label="Sections">
  <p class="root" aria-hidden="true">
    {rootLabel}
  </p>
  <ul role="list">
    {items.map((item, index) => {
      const isCurrent = item.id === currentId;
      return (
        <li>
          <a
            href={item.path}
            class:list={['item', item.kind, { current: isCurrent }]}
            data-nav-order={index + 1}
            aria-current={isCurrent ? 'page' : undefined}
          >
            <span class:list={['branch', { last: index === lastIndex }]} aria-hidden="true" />
            <span class="label">{item.label}</span>
            <span class="marker" aria-hidden="true">
              ◂
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .root {
    margin-block-end: var(--space-2);
    padding-inline: var(--space-2);
    font-weight: var(--weight-bold);
    color: var(--color-info);
  }

  /* No gap between rows, so the tree's vertical line runs unbroken from row to row. */
  ul {
    display: grid;
  }

  .item {
    display: flex;
    align-items: center;
    min-block-size: var(--nav-row);
    padding-inline: var(--space-2);
    font-size: var(--text-md);
    white-space: nowrap;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .item.directory {
    color: var(--color-info);
  }

  /* "├──" / "└──" drawn with borders instead of box-drawing characters: the characters stop at
     the text's height, which left a gap in the vertical line between rows. Here the vertical
     line spans the whole row (half of it on the last row) and the first one reaches up to the
     "~/saurabh" root. Same 3ch + 1ch space as the old "├── " text, so labels do not move. */
  .branch {
    position: relative;
    flex-shrink: 0;
    align-self: stretch;
    inline-size: 3ch;
    margin-inline-end: var(--space-ch);
  }

  .branch::before,
  .branch::after {
    position: absolute;
    inset-inline-start: 0.5ch;
    content: '';
  }

  .branch::before {
    inset-block: 0;
    border-inline-start: var(--border-width) solid var(--color-text-faint);
  }

  li:first-child .branch::before {
    inset-block-start: calc(var(--space-2) * -1);
  }

  .branch.last::before {
    inset-block-end: 50%;
  }

  .branch::after {
    inset-block-start: 50%;
    inset-inline-end: 0;
    border-block-start: var(--border-width) solid var(--color-text-faint);
  }

  .label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .marker {
    margin-inline-start: auto;
    padding-inline-start: var(--space-2);
    visibility: hidden;
  }

  /* No highlight box: hover and the current page only change the text colour; the current
     page also shows the ◂ marker. */
  .item:hover {
    color: var(--color-accent);
  }

  .item.current {
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }

  .item.current .marker {
    visibility: visible;
  }
</style>
