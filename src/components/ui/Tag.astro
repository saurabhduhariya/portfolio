---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<li class="tag">{label}</li>

<style>
  .tag {
    padding: 0 var(--space-2);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
    color: var(--color-tag);
    border: var(--border-width) solid color-mix(in srgb, var(--color-tag) 40%, transparent);
    border-radius: var(--radius);
  }
</style>
