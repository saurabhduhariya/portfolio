---
import Tag from '@/components/ui/Tag.astro';

interface Props {
  items: readonly string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul class="tag-list" role="list" aria-label={label}>
  {items.map((item) => (
    <Tag label={item} />
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
