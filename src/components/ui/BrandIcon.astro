---
// Renders a simple-icons logo as inline SVG at build time (no JS shipped).
// Uses currentColor, so the colour comes from the surrounding text token.
import { brandIcon } from '@/lib/brand';

interface Props {
  /** simple-icons slug, e.g. "typescript". */
  slug: string;
}

const icon = brandIcon(Astro.props.slug);
---

{icon && (
  <svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d={icon.path} fill="currentColor" />
  </svg>
)}

<style>
  .brand-icon {
    flex-shrink: 0;
    inline-size: 1em;
    block-size: 1em;
  }
</style>
